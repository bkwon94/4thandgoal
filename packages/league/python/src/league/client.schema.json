{
  "$defs": {
    "AnalyzerValues": {
      "additionalProperties": false,
      "description": "The package values of analyzer. The finder is off by default.",
      "properties": {
        "finder": {
          "default": false,
          "title": "Finder",
          "type": "boolean"
        }
      },
      "title": "AnalyzerValues",
      "type": "object"
    },
    "LeagueValues": {
      "additionalProperties": false,
      "description": "The package values of league. The default is no chart, and then each chart value is 0.",
      "properties": {
        "chart": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chart"
        }
      },
      "title": "LeagueValues",
      "type": "object"
    },
    "ManagersValues": {
      "additionalProperties": false,
      "description": "The package values of managers. It has none yet.",
      "properties": {},
      "title": "ManagersValues",
      "type": "object"
    },
    "Menu": {
      "additionalProperties": false,
      "description": "The menu layout and its items. With no items, the menu takes the home page, then the package list in its order.",
      "properties": {
        "layout": {
          "default": "hamburger",
          "enum": [
            "hamburger",
            "bar",
            "tabs"
          ],
          "title": "Layout",
          "type": "string"
        },
        "items": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/MenuItem"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Items"
        }
      },
      "title": "Menu",
      "type": "object"
    },
    "MenuItem": {
      "additionalProperties": false,
      "description": "One menu item: the home page or one package of the list, with an optional label.",
      "properties": {
        "page": {
          "anyOf": [
            {
              "const": "home",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "package": {
          "anyOf": [
            {
              "enum": [
                "week",
                "rankings",
                "managers",
                "waiver",
                "analyzer"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Package"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        }
      },
      "title": "MenuItem",
      "type": "object"
    },
    "PackageValues": {
      "additionalProperties": false,
      "description": "The [values.<package>] tables. A client sets only the values that differ from the defaults.",
      "properties": {
        "league": {
          "$ref": "#/$defs/LeagueValues"
        },
        "week": {
          "$ref": "#/$defs/WeekValues"
        },
        "rankings": {
          "$ref": "#/$defs/RankingsValues"
        },
        "managers": {
          "$ref": "#/$defs/ManagersValues"
        },
        "waiver": {
          "$ref": "#/$defs/WaiverValues"
        },
        "analyzer": {
          "$ref": "#/$defs/AnalyzerValues"
        }
      },
      "title": "PackageValues",
      "type": "object"
    },
    "RankingsValues": {
      "additionalProperties": false,
      "description": "The package values of rankings. It has none yet.",
      "properties": {},
      "title": "RankingsValues",
      "type": "object"
    },
    "Season": {
      "additionalProperties": false,
      "description": "The provider and the league id of one season. The provider gives the league a new id each season.",
      "properties": {
        "provider": {
          "const": "sleeper",
          "title": "Provider",
          "type": "string"
        },
        "league_id": {
          "title": "League Id",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "league_id"
      ],
      "title": "Season",
      "type": "object"
    },
    "WaiverValues": {
      "additionalProperties": false,
      "description": "The package values of waiver. It has none yet.",
      "properties": {},
      "title": "WaiverValues",
      "type": "object"
    },
    "WeekValues": {
      "additionalProperties": false,
      "description": "The package values of week. It has none yet.",
      "properties": {},
      "title": "WeekValues",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The values of one client. The seasons, the timezone, and the package list are required.",
  "properties": {
    "packages": {
      "items": {
        "enum": [
          "week",
          "rankings",
          "managers",
          "waiver",
          "analyzer"
        ],
        "type": "string"
      },
      "title": "Packages",
      "type": "array"
    },
    "timezone": {
      "title": "Timezone",
      "type": "string"
    },
    "usage_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Usage Code"
    },
    "seasons": {
      "additionalProperties": {
        "$ref": "#/$defs/Season"
      },
      "minProperties": 1,
      "title": "Seasons",
      "type": "object"
    },
    "values": {
      "$ref": "#/$defs/PackageValues"
    },
    "menu": {
      "$ref": "#/$defs/Menu"
    }
  },
  "required": [
    "packages",
    "timezone",
    "seasons"
  ],
  "title": "ClientValues",
  "type": "object"
}
