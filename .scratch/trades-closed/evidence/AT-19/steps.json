{
  "route": "/",
  "clients": [
    "norcal"
  ],
  "steps": [
    {
      "wait": "role=dialog[name=\"Which team is yours?\"] >> role=button"
    },
    {
      "click": "role=dialog[name=\"Which team is yours?\"] >> role=button"
    },
    {
      "wait": "role=dialog[name=\"Suggestions\"] >> role=button[name=\"Skip\"]"
    },
    {
      "click": "role=dialog[name=\"Suggestions\"] >> role=button[name=\"Skip\"]"
    },
    {
      "wait": 800
    },
    {
      "click": "button[aria-label=\"Open the menu\"]:visible, h1:visible"
    },
    {
      "wait": 1000
    },
    {
      "shot": "menu"
    },
    {
      "click": "a[href=\"/analyze/\"]:visible"
    },
    {
      "wait": "url"
    },
    {
      "wait": "role=dialog[name=\"League Passphrase\"] >> role=textbox[name=\"Passphrase\"]"
    },
    {
      "fill": {
        "selector": "role=dialog[name=\"League Passphrase\"] >> role=textbox[name=\"Passphrase\"]",
        "value": "localtest"
      }
    },
    {
      "click": "role=button[name=\"Continue\"]"
    },
    {
      "wait": "[role=radiogroup][aria-label=\"Mode\"]"
    },
    {
      "wait": 800
    },
    {
      "wait": 5000
    },
    {
      "shot": "analyze"
    }
  ]
}
