    {
      "wait": "ul[aria-label=\"All Topics\"] button:enabled[aria-label^=\"Start or sit:\"]"
    },
    {
      "wait": 500
    },
    {
      "click": "ul[aria-label=\"All Topics\"] button:enabled[aria-label^=\"Start or sit:\"]"
    },
    {
      "wait": 1000
