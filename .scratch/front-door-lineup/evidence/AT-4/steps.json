        "value": "localtest"
      }
    },
    {
      "click": "button[aria-label=\"Ask with this passphrase\"]"
    },
    {
      "wait": 2500
    },
    {
      "click": "button[aria-label^=\"Your team:\"]"
    },
    {
      "wait": "[role=dialog] button:has-text(\"puurdygood\")"
    },
    {
      "wait": 1000
    },
    {
      "click": "[role=dialog] button:has-text(\"puurdygood\")"
    },
    {
      "wait": "[aria-label=\"Suggestions\"]"
    },
    {
      "wait": 1500
    },
    {
      "click": "[aria-label=\"Suggestions\"] > button:has-text(\"More\")"
