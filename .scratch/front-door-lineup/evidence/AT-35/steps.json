{
  "route": "/ask/",
  "steps": [
    {
      "wait": "text=Which team is yours?"
    },
    {
      "wait": 1200
    },
    {
      "click": "[role=dialog] button:has-text(\"NFC Least\")"
    },
    {
      "wait": "[aria-label=\"Suggestions\"]"
    },
    {
      "wait": 1500
    },
    {
      "fill": {
        "selector": "input[aria-label=\"Ask a question\"]",
        "value": "What moves happened in week 9?"
      }
    },
    {
      "click": "button[aria-label=\"Send\"]"
    },
    {
      "wait": "input[type=password]"
    },
    {
      "fill": {
        "selector": "input[type=password]",
        "value": "localtest"
      }
    },
    {
      "click": "button[aria-label=\"Ask with this passphrase\"]"
    },
    {
      "wait": 1500
    },
    {
      "wait": "article[aria-label=\"What moves happened in week 9?\"]:not([aria-busy=\"true\"]):not(:has(input[type=password]))"
    },
    {
      "wait": 1500
    },
    {
      "wait": "[data-block=\"feed\"] [data-you]"
    },
    {
      "wait": 1500
    },
    {
      "scroll": "end"
    },
    {
      "wait": 600
    },
    {
      "scroll": "[data-block=\"feed\"] li:has-text(\"Kendre Miller\"):has-text(\"Sat\")"
    },
    {
      "wait": 1200
    }
  ]
}
