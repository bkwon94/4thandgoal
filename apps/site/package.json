{
  "name": "4thandgoal-site",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "node scripts/client-build.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/client-build.mjs",
    "build": "next build",
    "typecheck": "next typegen && bun check --no-script",
    "test": "pnpm test:bun",
    "test:bun": "node scripts/bun-test.mjs",
    "lint": "cd ../.. && apps/site/node_modules/.bin/oxlint --deny-warnings --no-error-on-unmatched-pattern ${LINT_FILES:-apps/site packages/*/site packages/design/lint/plugin.mjs packages/design/lint/rules/*.mjs}",
    "fmt": "cd ../.. && bun fmt --no-script --ignore-pattern apps/site/next-env.d.ts ${FMT_FILES:-'apps/site/**/*.{ts,tsx,mjs,mts,css}' 'packages/*/site/**/*.{ts,tsx,css}' packages/design/lint/plugin.mjs packages/design/lint/rules/*.mjs}",
    "fmt:check": "cd ../.. && bun fmt --no-script --check --no-error-on-unmatched-pattern --ignore-pattern apps/site/next-env.d.ts ${FMT_FILES:-'apps/site/**/*.{ts,tsx,mjs,mts,css}' 'packages/*/site/**/*.{ts,tsx,css}' packages/design/lint/plugin.mjs packages/design/lint/rules/*.mjs}",
    "check:export": "node scripts/check-export.mjs",
    "check:floor": "node scripts/check-floor.mjs",
    "test:floor": "playwright test --project=rules",
    "test:eggs": "playwright test --project=eggs",
    "evidence": "node scripts/evidence.mjs",
    "smoke": "node scripts/smoke.mjs",
    "pick": "node scripts/flow-pick.mjs",
    "check:grade-bar": "CLIENT=norcal NEXT_PUBLIC_API_URL=http://localhost:8080 pnpm build && pnpm check:grade-bar-export",
    "check:grade-bar-export": "playwright test --project=grade-bar",
    "check:open-card": "playwright test --project=open-card",
    "check": "pnpm check:fast && pnpm check:browser",
    "check:browser": "pnpm test:floor && node scripts/build-each-client.mjs && node scripts/midseason-fixture.mjs",
    "check:fast": "CLIENT=cpc node scripts/client-build.mjs && python3 -B ../../scripts/parallel.py lint 'pnpm lint' fmt 'pnpm fmt:check' typecheck 'pnpm typecheck' test 'pnpm test:bun'",
    "hook:install": "prek install"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.163",
    "@base-ui/react": "^1.9.0",
    "@cpc/analyzer": "workspace:*",
    "@cpc/design": "workspace:*",
    "@cpc/eggs": "workspace:*",
    "@cpc/league": "workspace:*",
    "@cpc/managers": "workspace:*",
    "@cpc/midseason": "workspace:*",
    "@cpc/rankings": "workspace:*",
    "@cpc/sim": "workspace:*",
    "@cpc/waiver": "workspace:*",
    "@cpc/week": "workspace:*",
    "ai": "7.0.159",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "framer-motion": "^14.5.0",
    "lucide-react": "^1.61.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tw-animate-css": "^1.4.0",
    "unicode-animations": "1.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@happy-dom/global-registrator": "^21.0.4",
    "@playwright/test": "~1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "1.4.5",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ajv": "^8.20.0",
    "oxlint": "^1.94.0",
    "postcss": "^8.5.31",
    "shadcn": "^4.22.1",
    "smol-toml": "^1.9.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
